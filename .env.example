# Required for all variations (LLM calls + LLM judges)
OPENAI_API_KEY=sk-...
# Optional: override the default model (gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Variation 02 only — Langfuse (cloud or self-hosted)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com  # or http://localhost:3000 for self-hosted

# Judge backend: openai (default) or jev
JUDGE_BACKEND=openai
# Required only when JUDGE_BACKEND=jev (https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=
# Probability cutoff for Jev verdicts (default 0.5)
# JEV_THRESHOLD=0.5
